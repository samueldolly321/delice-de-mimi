# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL : adresse publique du site, sans « / » final (ex. https://delice-de-mimi.onrender.com).
# Utilisée pour le sitemap, robots.txt et les aperçus sur les réseaux sociaux.
APP_URL="https://delice-de-mimi.onrender.com"

# GA_MEASUREMENT_ID : (optionnel) identifiant Google Analytics 4, ex. G-ABC123XYZ.
# Vide = pas de mesure d'audience et pas de bandeau cookies.
GA_MEASUREMENT_ID=""

# DATABASE_URL: URL de connexion à votre base PostgreSQL locale (avec Drizzle ORM)
# Exemple pour votre machine :
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/saveurs_asie"

# ACCÈS ADMINISTRATEUR — OBLIGATOIRE
# Sans ces deux variables, la connexion à /admin-user est refusée (aucun mot de passe par défaut).
# Choisissez un mot de passe fort, propre à ce site.
ADMIN_EMAIL="votre@email.mg"
ADMIN_PASSWORD="ChangezMoi123!"

# NOTIFICATIONS DE COMMANDES (Email & Téléphone / WhatsApp)
# Adresse email du gérant qui recevra les alertes à chaque nouvelle commande
NOTIFICATION_EMAIL="contact@saveursdasie.mg"
# Numéro de téléphone / WhatsApp du gérant (+261...)
NOTIFICATION_PHONE="+261342088899"

# (Optionnel) Configuration SMTP pour envoi réel d'emails (ex: Gmail, Brevo, Outlook, OVH)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Saveurs d'Asie Commandes <commandes@saveursdasie.mg>"

# (Optionnel) Passerelle SMS Twilio pour envoi de SMS directs au gérant
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""


# (Optionnel) Clé de signature des sessions clients. Si absente, elle est dérivée
# de DATABASE_URL. La changer déconnecte tous les clients (ils se reconnectent).
# Exemple : une longue chaîne aléatoire.
CUSTOMER_TOKEN_SECRET=""
